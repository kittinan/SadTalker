[Unit]
Description=SadTalker Uvicorn API
After=network.target

[Service]
Type=simple
User=tun
WorkingDirectory=/home/tun/code/SadTalker
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source /home/tun/miniconda3/etc/profile.d/conda.sh && conda activate sadtalker && exec python -m uvicorn api:app --host 0.0.0.0 --port 8006'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
